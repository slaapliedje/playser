 extern const FFCodec ff_libcodec2_encoder;
 extern const FFCodec ff_libcodec2_decoder;
 extern const FFCodec ff_libdav1d_decoder;
+extern const FFCodec ff_libedge264mvc_decoder;
 extern const FFCodec ff_libdavs2_decoder;
 extern const FFCodec ff_libfdk_aac_encoder;
 extern const FFCodec ff_libfdk_aac_decoder;
diff --git a/libavcodec/libedge264mvc.c b/libavcodec/libedge264mvc.c
new file mode 100644
index 0000000..64baea8
--- /dev/null
+++ b/libavcodec/libedge264mvc.c
@@ -0,0 +1,245 @@
+/*
+ * H.264 and H.264 MVC (3D Blu-ray) decoding via edge264-mvc
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/**
+ * @file
+ * Decodes both views of an MVC stream (the dependent view's NAL units, types
+ * 15 and 20, following the base view's in each packet) and outputs them as
+ * one full side-by-side frame, left eye | right eye. The base view is the left
+ * eye unless base_view_right is set (a Blu-ray playlist's MVC base view flag).
+ * A 2D stream, or a frame whose dependent view is missing, repeats the base view.
+ * With side_by_side off, only the left eye is output (3D content on a 2D
+ * display).
+ */
+
+#include <edge264mvc.h>
+
+#include "libavutil/imgutils.h"
+#include "libavutil/opt.h"
+#include "libavutil/stereo3d.h"
+
+#include "avcodec.h"
+#include "codec_internal.h"
+#include "decode.h"
+
+typedef struct Libedge264MvcContext {
+    const AVClass *class;
+    Edge264MvcDecoder *dec;
+    AVPacket *pkt;   // packet being sent, from pkt_pos on
+    int pkt_pos;
+    int ended;       // edge264mvc_send_end was called
+    int threads;     // options
+    int base_view_right;
+    int side_by_side;
+} Libedge264MvcContext;
+
+static av_cold int libedge264mvc_init(AVCodecContext *avctx)
+{
+    Libedge264MvcContext *s = avctx->priv_data;
+    Edge264MvcSettings settings;
+
+    edge264mvc_default_settings(&settings);
+    settings.n_threads = s->threads ? s->threads : avctx->thread_count;
+    if (edge264mvc_open(&s->dec, &settings) != EDGE264MVC_OK)
+        return AVERROR(ENOMEM);
+    s->pkt = av_packet_alloc();
+    if (!s->pkt)
+        return AVERROR(ENOMEM);
+    av_log(avctx, AV_LOG_VERBOSE, "edge264-mvc %s\n", edge264mvc_version());
+    return 0;
+}
+
+static av_cold int libedge264mvc_close(AVCodecContext *avctx)
+{
+    Libedge264MvcContext *s = avctx->priv_data;
+
+    edge264mvc_close(&s->dec);
+    av_packet_free(&s->pkt);
+    return 0;
+}
+
+static av_cold void libedge264mvc_flush(AVCodecContext *avctx)
+{
+    Libedge264MvcContext *s = avctx->priv_data;
+
+    edge264mvc_flush(s->dec);
+    av_packet_unref(s->pkt);
+    s->pkt_pos = 0;
+    s->ended = 0;
+}
+
+static int output_frame(AVCodecContext *avctx, const Edge264MvcFrame *f, AVFrame *frame)
+{
+    Libedge264MvcContext *s = avctx->priv_data;
+    const Edge264MvcView *base = &f->views[0];
+    const Edge264MvcView *dep = f->views[1].planes[0] ? &f->views[1] : base;
+    const Edge264MvcView *left = s->base_view_right ? dep : base;
+    const Edge264MvcView *right = s->base_view_right ? base : dep;
+    AVStereo3D *stereo;
+    int ret;
+
+    if (f->bit_depth_Y != 8 || f->bit_depth_C != 8 || f->width_C * 2 != f->width_Y ||
+        f->height_C * 2 != f->height_Y) {
+        avpriv_report_missing_feature(avctx, "Frames other than 8-bit 4:2:0");
+        return AVERROR_PATCHWELCOME;
+    }
+    ret = ff_set_dimensions(avctx, f->width_Y * (s->side_by_side ? 2 : 1), f->height_Y);
+    if (ret < 0)
+        return ret;
+    avctx->pix_fmt = AV_PIX_FMT_YUV420P;
+    ret = ff_get_buffer(avctx, frame, 0);
+    if (ret < 0)
+        return ret;
+
+    for (int p = 0; p < 3; p++) {
+        const int w = p ? f->width_C : f->width_Y;
+        const int h = p ? f->height_C : f->height_Y;
+        const int stride = p ? f->stride_C : f->stride_Y;
+        av_image_copy_plane(frame->data[p], frame->linesize[p],
+                            left->planes[p], stride, w, h);
+        if (s->side_by_side)
+            av_image_copy_plane(frame->data[p] + w, frame->linesize[p],
+                                right->planes[p], stride, w, h);
+    }
+
+    frame->pts = base->pts;
+    frame->pkt_dts = AV_NOPTS_VALUE;
+    if (base->flags & EDGE264MVC_VIEW_IDR)
+        frame->flags |= AV_FRAME_FLAG_KEY;
+    if ((left->flags | right->flags) & EDGE264MVC_VIEW_CONCEALED)
+        frame->flags |= AV_FRAME_FLAG_CORRUPT;
+    if (dep != base && s->side_by_side) {
+        stereo = av_stereo3d_create_side_data(frame);
+        if (!stereo)
+            return AVERROR(ENOMEM);
+        stereo->type = AV_STEREO3D_SIDEBYSIDE;
+    }
+    return 0;
+}
+
+// Sends the NAL units of the current packet. Returns 0 when all are sent,
+// AVERROR(EAGAIN) when the decoder is full (receive, then call again).
+static int send_packet(AVCodecContext *avctx)
+{
+    Libedge264MvcContext *s = avctx->priv_data;
+    const uint8_t *buf = s->pkt->data;
+    const int size = s->pkt->size;
+
+    while (s->pkt_pos < size) {
+        size_t start = s->pkt_pos + edge264mvc_find_start_code(buf + s->pkt_pos, size - s->pkt_pos);
+        size_t nal, end;
+        int ret;
+
+        if (start >= size)
+            break;
+        nal = start + 3;
+        end = nal + edge264mvc_find_start_code(buf + nal, size - nal);
+        // a 4-byte start code's leading zero, and trailing zeros, aren't payload
+        while (end > nal && end < size && !buf[end - 1])
+            end--;
+        ret = edge264mvc_send_nal(s->dec, buf + nal, end - nal, s->pkt->pts, 0);
+        if (ret == EDGE264MVC_AGAIN)
+            return AVERROR(EAGAIN);
+        if (ret == EDGE264MVC_NOMEM)
+            return AVERROR(ENOMEM);
+        if (ret == EDGE264MVC_INVALID)
+            return AVERROR_BUG;
+        // UNSUPPORTED (e.g. the type-24 NALs of 3D Blu-rays) and CORRUPT are skipped
+        s->pkt_pos = end;
+    }
+    av_packet_unref(s->pkt);
+    s->pkt_pos = 0;
+    return 0;
+}
+
+static int libedge264mvc_receive_frame(AVCodecContext *avctx, AVFrame *frame)
+{
+    Libedge264MvcContext *s = avctx->priv_data;
+
+    for (;;) {
+        Edge264MvcFrame f;
+        int ret = edge264mvc_receive_frame(s->dec, &f);
+
+        if (ret == EDGE264MVC_OK) {
+            ret = output_frame(avctx, &f, frame);
+            edge264mvc_release_frame(s->dec, &f);
+            return ret;
+        }
+        if (ret == EDGE264MVC_END)
+            return AVERROR_EOF;
+        if (ret != EDGE264MVC_AGAIN)
+            return AVERROR_BUG;
+
+        if (s->pkt->data) {
+            ret = send_packet(avctx);
+            if (ret == AVERROR(EAGAIN))
+                continue; // receiving now waits for a frame
+            if (ret < 0)
+                return ret;
+            continue;
+        }
+        if (s->ended)
+            return AVERROR_EOF;
+        ret = ff_decode_get_packet(avctx, s->pkt);
+        if (ret == AVERROR_EOF) {
+            edge264mvc_send_end(s->dec);
+            s->ended = 1;
+            continue;
+        }
+        if (ret < 0)
+            return ret;
+        s->pkt_pos = 0;
+    }
+}
+
+#define OFFSET(x) offsetof(Libedge264MvcContext, x)
+#define VD AV_OPT_FLAG_VIDEO_PARAM | AV_OPT_FLAG_DECODING_PARAM
+static const AVOption libedge264mvc_options[] = {
+    { "edge264mvc_threads", "Worker threads (0: the codec context's thread count; 1: decode on the calling thread)",
+      OFFSET(threads), AV_OPT_TYPE_INT, { .i64 = 0 }, 0, 128, VD },
+    { "base_view_right", "The base view is the right eye (Blu-ray: the playlist's MVC base view flag)",
+      OFFSET(base_view_right), AV_OPT_TYPE_BOOL, { .i64 = 0 }, 0, 1, VD },
+    { "side_by_side", "Output both eyes side by side (off: the left eye only)",
+      OFFSET(side_by_side), AV_OPT_TYPE_BOOL, { .i64 = 1 }, 0, 1, VD },
+    { NULL }
+};
+
+static const AVClass libedge264mvc_class = {
+    .class_name = "libedge264mvc decoder",
+    .item_name  = av_default_item_name,
+    .option     = libedge264mvc_options,
+    .version    = LIBAVUTIL_VERSION_INT,
+};
+
+const FFCodec ff_libedge264mvc_decoder = {
+    .p.name         = "libedge264mvc",
+    CODEC_LONG_NAME("edge264-mvc H.264 / MVC 3D (side-by-side output)"),
+    .p.type         = AVMEDIA_TYPE_VIDEO,
+    .p.id           = AV_CODEC_ID_H264,
+    .priv_data_size = sizeof(Libedge264MvcContext),
+    .init           = libedge264mvc_init,
+    .close          = libedge264mvc_close,
+    .flush          = libedge264mvc_flush,
+    FF_CODEC_RECEIVE_FRAME_CB(libedge264mvc_receive_frame),
+    .p.capabilities = AV_CODEC_CAP_DELAY | AV_CODEC_CAP_OTHER_THREADS,
+    .caps_internal  = FF_CODEC_CAP_SETS_FRAME_PROPS | FF_CODEC_CAP_AUTO_THREADS,
+    .p.priv_class   = &libedge264mvc_class,
+    .p.wrapper_name = "libedge264mvc",
+};
-- 
