--- a/libavcodec/Makefile
+++ b/libavcodec/Makefile
@@ -1172,6 +1172,7 @@ OBJS-$(CONFIG_LIBARIBCAPTION_DECODER)     += libaribcaption.o ass.o
 OBJS-$(CONFIG_LIBCODEC2_DECODER)          += libcodec2.o
